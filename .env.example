# 服务端口（容器内部端口，对外通过 Nginx 反代）
PORT=8787

# 单用户登录密码。建议 12+ 位含字母数字符号。
APP_PASSWORD=change-me-to-a-strong-password

# Session 签名密钥。可用 `openssl rand -hex 32` 生成。留空则启动时随机生成（重启后所有人登出）。
SESSION_SECRET=

# Cookie 是否仅在 HTTPS 下传输。生产环境（Nginx + HTTPS）务必设为 true。
COOKIE_SECURE=false

# we-mp-rss 服务地址。docker-compose 部署时通常指向同一网络内的服务名。
WE_MP_RSS_URL=http://127.0.0.1:8001

# we-mp-rss 鉴权（如已登录获取到 license 后填入，可选）
WE_MP_RSS_WX_LIC=
